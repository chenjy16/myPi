# Shopify CLI supplies SHOPIFY_API_KEY, SHOPIFY_API_SECRET, SHOPIFY_APP_URL and SCOPES.
# Prisma/Postgres connection string for the app DB (never commit the real value).
# On Supabase, use the SESSION pooler URI (IPv4). The direct endpoint
# db.<project-ref>.supabase.co is IPv6-only and fails with P1001 from an IPv4-only network.
# Copy the host and the postgres.<project-ref> username from Dashboard > Connect >
# Session pooler - the pooler host cannot be composed from the region name.
# Keep sslmode=require; Supabase enforces SSL.
# connect_timeout raises the per-connection budget above Prisma's 5s default, which
# cross-region cold connects (3-5s) regularly exceed.
DATABASE_URL=postgresql://postgres.<PROJECT-REF>:PASSWORD@aws-<INDEX>-<REGION>.pooler.supabase.com:5432/postgres?sslmode=require&connect_timeout=20
# Connection pool budget (P0-3). These are merged into DATABASE_URL only when the
# value is not already present in the string, so an explicit URL param always wins.
# Web and Worker are separate processes, each with its own pool; the total backends
# they hold must stay under the Supabase Session pooler's max client connections.
# Per-process pool ceiling. Default 10; a 2-process (Web + Worker) container holds ~20.
DB_CONNECTION_LIMIT=10
# Seconds to wait to acquire a connection from the pool before failing. Default 10.
DB_POOL_TIMEOUT_SECONDS=10
# Seconds to establish a single connection. Default 20 (cross-region cold connects).
DB_CONNECT_TIMEOUT_SECONDS=20
# Background worker cron expressions (node-cron). Defaults: hourly snapshot, daily 03:00 sales rebuild.
WORKER_SNAPSHOT_CRON=15 * * * *
WORKER_SALES_CRON=0 3 * * *
# Automation engine poll cadence (queue drain) and per-sweep batch cap.
# */2 * * * * = every 2 minutes; each sweep claims at most WORKER_AUTOMATION_BATCH queued events.
WORKER_AUTOMATION_CRON=*/2 * * * *
WORKER_AUTOMATION_BATCH=20
# Webhook delivery dedupe-row prune cadence (drops rows older than WEBHOOK_DELIVERY_TTL_HOURS).
WORKER_DELIVERY_PRUNE_CRON=45 * * * *
# Execution-retention prune cadence (drops ExecutionLog/Step older than EXECUTION_RETENTION_DAYS).
WORKER_RETENTION_PRUNE_CRON=30 4 * * *
# Missed-delivery reconcile sweep cadence; actual run is gated by RECONCILE_ENABLED (default off).
WORKER_RECONCILE_CRON=*/30 * * * *
# Minutes a "running" sync row may live before the lease is considered expired and the row
# is reclaimed as failed (releasing the task lock). Default 30.
WORKER_JOB_LEASE_MINUTES=30
# Milliseconds the worker waits for prisma.$disconnect() on SIGTERM/SIGINT before forcing
# exit, so a container stop can't hang the process. Default 10000.
WORKER_SHUTDOWN_GRACE_MS=10000
# Seconds to coalesce bursty inventory_levels/update webhooks into one snapshot refresh.
WEBHOOK_SNAPSHOT_COALESCE_SECONDS=60

# ---- Automation engine (V2) operational knobs -------------------------------------------
# Feature flag AUTOMATION_ENABLED lives in app/features.ts (compile-time, read by the client
# bundle too — it is NOT an env var). Only the runtime execution gate below is env-driven.
# Safe by default: the worker performs zero side-effectful automations until this is "true".
# Staged rollout flips this in production; leave unset (off) for local/demo.
AUTOMATION_EXECUTION_ENABLED=false
# 32-byte hex key that encrypts Integration secrets at rest (crypto-box). Required in prod;
# generate with `openssl rand -hex 32`. Never commit a real value; secrets are stored ciphertext-only.
AUTOMATION_SECRET_KEY=
# Hours a webhook delivery dedupe row is kept before prune. Default 24, hard max 168 (7d).
WEBHOOK_DELIVERY_TTL_HOURS=24
# Days ExecutionLog/ExecutionStep are retained before prune (rows referencing a customer are
# masked first, then deleted). Default 180.
EXECUTION_RETENTION_DAYS=180
# Loop guardrails (cascade-depth cap + throttle windows). Invalid values fall back to safe
# defaults and are clamped: depth<=10, windows<=3600000ms, count<=100.
LOOP_MAX_CASCADE_DEPTH=3
LOOP_DEDUP_WINDOW_MS=60000
LOOP_RATE_LIMIT_WINDOW_MS=300000
LOOP_RATE_LIMIT_COUNT=5
# Retry policy for failed steps. Attempts include the first; backoff is capped (ms).
# EXECUTION_MAX_ATTEMPTS default 3, hard max 10; EXECUTION_BACKOFF_CAP_MS default 5000, max 30000.
EXECUTION_MAX_ATTEMPTS=3
EXECUTION_BACKOFF_CAP_MS=5000
# Minutes a claimed queue event may run before its lease expires and it is re-queued. Default 10, max 60.
EXECUTION_LEASE_MINUTES=10
# Missed-delivery reconciliation (P4-13). Off by default; when true the worker sweeps each store's
# Admin API for changes in the lookback window and re-queues any that never executed (idempotent).
RECONCILE_ENABLED=false
RECONCILE_INTERVAL_MINUTES=30
# Lookback window per sweep; defaults to 2x interval (overlap is deduped by synthetic keys).
RECONCILE_LOOKBACK_MINUTES=60
# Email action provider keys (OQ-8 — provider not yet selected; wire when chosen, e.g. RESEND_API_KEY=).
# -----------------------------------------------------------------------------------
# Attempts for Admin GraphQL calls, including the first one. Shopify's client only retries
# 429/503 when tries is set; default 3, hard max 4 (library limit).
SHOPIFY_GRAPHQL_TRIES=3
# Milliseconds /health waits for the database ping before reporting 503. Default 3000, max 10000.
HEALTH_CHECK_TIMEOUT_MS=3000
# /health automation dimension (P4-17). These never affect the 503 decision (DB-down only);
# they size the metric window and the per-query degradation guards. All fall back to safe defaults.
# Rollup window for execution success rate. Default 86400000 (24h), max 7d.
HEALTH_AUTOMATION_WINDOW_MS=86400000
# Age past which worker heartbeat (latest ScheduledJob.lastRunAt) is reported stale. Default 900000 (15m).
HEALTH_WORKER_HEARTBEAT_STALE_MS=900000
# Per-query budget; on timeout the field degrades to "unknown" instead of failing the probe. Default 2000, max 8000.
HEALTH_AUTOMATION_QUERY_TIMEOUT_MS=2000
# Build/version label surfaced by /health. Injected by CI or the container build.
APP_VERSION=
# Set a server-side model key for product copy generation.
PI_API_KEY=
PI_PROVIDER=openai
PI_MODEL=gpt-4.1-mini
